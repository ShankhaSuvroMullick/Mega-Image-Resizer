from graphviz import Digraph
import os

# Ensure output folder exists
os.makedirs("docs/flowcharts", exist_ok=True)

# Function to create a flowchart
def create_flowchart(name, nodes, edges, output_name):
    dot = Digraph(comment=name)
    for node_id, node_label in nodes.items():
        dot.node(node_id, node_label)
    for edge in edges:
        if len(edge) == 2:
            dot.edge(edge[0], edge[1])
        elif len(edge) == 3:
            dot.edge(edge[0], edge[1], label=edge[2])
    dot.render(f'docs/flowcharts/{output_name}', format='png', cleanup=True)
    print(f"✅ Flowchart saved: docs/flowcharts/{output_name}.png")

# 1) resize_fixed_cv
nodes1 = {'A': 'Start','B': 'Read Image with cv2.imread','C': 'Image Exists?','D': 'Resize with cv2.resize','E': 'Save Image with cv2.imwrite','F': 'Speak Notification','G': 'Return Resized Image / End'}
edges1 = [('A','B'), ('B','C'), ('C','D','Yes'), ('C','G','No'), ('D','E'), ('E','F'), ('F','G')]
create_flowchart("resize_fixed_cv Flow", nodes1, edges1, "resize_fixed_cv")

# 2) resize_fixed_pil
nodes2 = {'A':'Start', 'B':'Open Image with Pillow', 'C':'Resize using .resize()', 'D':'Save Image', 'E':'Speak Notification', 'F':'Return Resized Image / End'}
edges2 = [('A','B'),('B','C'),('C','D'),('D','E'),('E','F')]
create_flowchart("resize_fixed_pil Flow", nodes2, edges2, "resize_fixed_pil")

